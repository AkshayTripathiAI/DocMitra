# Copy to .env and fill in. Never commit .env.

# Chat model for the assistant agent, as "<provider>:<model>".
# Examples: google_genai:gemini-3.5-flash-lite  |  groq:openai/gpt-oss-120b  |  anthropic:claude-sonnet-5-5
LLM_MODEL=google_genai:gemini-3.5-flash-lite
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Where uploads and the SQLite database live (relative to backend/).
STORAGE_DIR=storage
DATABASE_URL=sqlite:///storage/docmitra.db

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5174

# Days before an expiry date to start reminding.
REMINDER_LEAD_DAYS=30

# Public demo: seed synthetic documents for a fictional person and block uploads/deletes.
DEMO_MODE=false
CHAT_RATE_LIMIT_PER_HOUR=30
